# Copy to machine.env and replace the paths and network interface for the target host.
DEPS_ROOT=/path/to/WORKSPACE
CONDA_ENV=/path/to/WORKSPACE/conda_env/glm53_flash_env_cann930
CANN_ROOT=/path/to/cann/cann-9.3.0
ATB_SET_ENV=/path/to/nnal/atb/set_env.sh
COMM_IFNAME=eth0
RAY_NODE_IP=127.0.0.1
RAY_SHORT_DIR=/tmp/slime-glm53-ray-18379
HF_CHECKPOINT=/path/to/weight/iter_0000300_bf16
PROMPT_DATA=/path/to/dataset/dapo-math-17k_lt8k_benchmark_slime.jsonl
NUM_ROLLOUT=2
CP_SIZE=1
# Use shared absolute lock paths when several launchers share this host.
# NPU_TASK_LOCK=/path/to/shared/npu-task.lock
# NPU_VALIDATION_LOCK=/path/to/shared/npu-validation.lock

# Historical diagnostics are disabled in this baseline configuration.
unset HCCL_ALGO SGLANG_NPU_GRAPH_CPU_BACKUP SGLANG_NPU_PRE_OFFLOAD_FENCE
