+def _npu_hc_pre_with_tail_guard(x, hc_fn, hc_scale, hc_base, **kwargs):
+    # The deployed A5 HcPreSinkhorn copies rowFactor rows even in a tail
+    # iteration whose curRowFactor is smaller. Keep the logical shape unchanged
+    # while backing the final input tile with storage. Opt in only for the
+    # validated GLM5 shape; no custom operator or numerical formula changes.
+    if os.getenv("SGLANG_NPU_HC_PRE_TAIL_GUARD", "0") == "1":
+        if x.dtype != torch.bfloat16 or tuple(x.shape[1:]) != (4, 4096):
+            raise ValueError("NPU hc_pre tail guard is validated for BF16 [tokens,4,4096]")
+        # 1 MiB = 32 complete rows, larger than the deployed kernel's
+        # double-buffered UB input tile. The original shape/strides are retained.
+        storage = torch.zeros(x.numel() + 524288, dtype=x.dtype, device=x.device)
+        guarded = storage[:x.numel()].view_as(x)
+        guarded.copy_(x)
+        x = guarded
+    return torch.ops.custom.npu_hc_pre(x, hc_fn, hc_scale, hc_base, **kwargs)
+
