diff --git a/slime/ray/train_actor.py b/slime/ray/train_actor.py
index e91bc5a2..e6f1730c 100644
--- a/slime/ray/train_actor.py
+++ b/slime/ray/train_actor.py
@@ -19,7 +19,11 @@ logger = logging.getLogger(__name__)
 
 
 def get_local_gpu_id():
-    return accelerator.resolve_visible_device_id(ray.get_gpu_ids()[0])
+    resource_name = accelerator.ray_resource_name()
+    resource_ids = ray.get_runtime_context().get_accelerator_ids().get(resource_name, [])
+    if not resource_ids:
+        raise RuntimeError(f"Ray did not assign a {resource_name} accelerator to this actor")
+    return accelerator.resolve_visible_device_id(resource_ids[0])
 
 
 class TrainRayActor(RayActor):
diff --git a/slime/utils/accelerator/__init__.py b/slime/utils/accelerator/__init__.py
index 98127eac..eb517f2c 100644
--- a/slime/utils/accelerator/__init__.py
+++ b/slime/utils/accelerator/__init__.py
@@ -525,5 +525,17 @@ def visible_devices_env_key() -> str:
     return _backend().visible_devices_env
 
 
+def ray_resource_name() -> str:
+    return _backend().ray_resource_name
+
+
+def ray_remote_options(amount: float) -> dict[str, Any]:
+    """Return Ray actor options for the selected accelerator resource."""
+    resource_name = ray_resource_name()
+    if resource_name == "GPU":
+        return {"num_gpus": amount}
+    return {"resources": {resource_name: amount}}
+
+
 def resolve_visible_device_id(physical_device_id: int | float | str) -> int:
     return _backend().resolve_visible_device_id(physical_device_id)
